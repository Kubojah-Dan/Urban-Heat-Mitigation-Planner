# ==========================================
# UrbanCool AI — GitHub Ignore Configuration
# ==========================================

# --- OS / System Metadata ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- IDE / Editor Configurations ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~
*.bak

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
lib/
pip-log.txt
pip-delete-this-directory.txt

# --- Python Compilation Caches ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# --- Environment Secrets & Configs ---
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
secret.json
secrets.json
firebase_service_account.json
*.pem
*.key
*.cert
*.pfx

# --- Big Geospatial & Satellite Datasets (GEE / OSM / CSVs) ---
**/data/raw/*
!**/data/raw/.gitkeep
**/data/processed/*
!**/data/processed/.gitkeep

# Ignore large downloaded GeoTIFF rasters, CSV tables, and pickle models
*.tif
*.tiff
*.zip
*.tar.gz
*.csv
*.xlsx
*.pkl
*.pickle
*.h5
*.nc
*.geojson
!**/data/boundaries/amc_wards.geojson

# --- Node & Frontend Build Tools ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.svelte-kit/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Local Log Files & Caches ---
*.log
logs/
